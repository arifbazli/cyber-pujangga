---
import { getCollection, render } from "astro:content";
import { type Locale, localePath, t } from "../../i18n";
import PieceLayout from "../../layouts/PieceLayout.astro";
import { localeOf, readingTime, slugOf } from "../../lib/content";

export async function getStaticPaths() {
  const entries = await getCollection("essays", ({ data }) => !data.draft);
  return entries
    .filter((e) => localeOf(e) === "en")
    .map((entry) => ({ params: { slug: slugOf(entry) }, props: { entry } }));
}

const locale: Locale = "en";
const strings = t(locale);
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<PieceLayout
  title={entry.data.title}
  description={entry.data.description}
  lang={locale}
  pubDate={entry.data.pubDate}
  updatedDate={entry.data.updatedDate}
  author={entry.data.author}
  readingMinutes={readingTime(entry.body)}
  backHref={localePath(locale, "essays")}
  backLabel={strings.section.essays}
  sectionLabel={entry.data.tags?.[0] ?? strings.section.essays}
  currentPath={`essays/${slugOf(entry)}`}
  tags={entry.data.tags}
>
  <Content />
</PieceLayout>
