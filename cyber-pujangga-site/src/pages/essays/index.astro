---
import { getCollection } from "astro:content";
import SectionLayout from "../../layouts/SectionLayout.astro";
import { t, localePath, type Locale } from "../../i18n";
import { filterByLocale, slugOf } from "../../lib/content";

const locale: Locale = "en";
const strings = t(locale);
const items = filterByLocale(await getCollection("essays", ({ data }) => !data.draft), locale);

function dateShort(d: Date): string {
	return d.toLocaleDateString("en-US", { day: "2-digit", month: "short", year: "numeric" });
}

const rows = items.map((e) => ({
	href: localePath(locale, "essays") + "/" + slugOf(e),
	sectionLabel: strings.section.essays,
	dateLabel: dateShort(e.data.pubDate),
	title: e.data.title,
	section: "essays" as const,
	lang: locale,
}));
---

<SectionLayout
	title={strings.section.essays}
	lang={locale}
	currentPath="essays"
	backLabel={strings.nav.back}
	backHref={localePath(locale)}
	emptyLabel="No essays yet."
	items={rows}
/>
