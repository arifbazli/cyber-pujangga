---
import { localePath, t } from "../i18n";
import BaseLayout from "../layouts/BaseLayout.astro";

const ms = t("ms");
const enStrings = t("en");
---

<BaseLayout title="404" description={ms.misc.notFound} lang="ms" currentPath="404">
	<main id="main">
		<section class="notfound">
			<h1>404</h1>
			<p>{ms.misc.notFound}</p>
			<p class="mono" lang="en">{enStrings.misc.notFound}</p>
			<p><a href={localePath("ms")} class="btn primary">{ms.misc.home}</a></p>
		</section>
	</main>
</BaseLayout>
