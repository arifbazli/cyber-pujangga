---
import { defaultLocale, localePath, t } from "../i18n";
import BaseLayout from "../layouts/BaseLayout.astro";

const strings = t(defaultLocale);
---

<BaseLayout title="404" description={strings.misc.notFound} lang={defaultLocale} currentPath="404">

	<section class="hero">
		<div class="hero-avatar-row">
			<div class="avatar-mark" aria-hidden="true">?</div>
			<div class="who">
				<strong>404</strong><br />the page you’re looking for isn’t here
			</div>
		</div>
		<h1 class="kinetic-title">404 — notfound</h1>
		<p class="lede">{strings.misc.notFound}</p>
	</section>

	<main id="main">
		<div class="notfound">
			<p><a href={localePath(defaultLocale)} class="btn primary">{strings.misc.home}</a></p>
		</div>
	</main>
</BaseLayout>