---
import { getCollection, render } from "astro:content";
import { type Locale, localePath, t } from "../../i18n";
import PieceLayout from "../../layouts/PieceLayout.astro";
import { localeOf, readingTime, slugOf } from "../../lib/content";

export async function getStaticPaths() {
  const entries = await getCollection("poems", ({ data }) => !data.draft);
  return entries
    .filter((e) => localeOf(e) === "en")
    .map((entry) => ({ params: { slug: slugOf(entry) }, props: { entry } }));
}

const locale: Locale = "en";
const strings = t(locale);
const { entry } = Astro.props;
const { Content } = await render(entry);

const strict = entry.data.strictLayout === true;
const poemCardUrl = `/poem-card/${entry.id}.png`;
---

<PieceLayout
	title={entry.data.title}
	description={entry.data.description}
	lang={locale}
	pubDate={entry.data.pubDate}
	author={entry.data.author ?? "Cyber Pujangga"}
	readingMinutes={readingTime(entry.body)}
	backHref={localePath(locale, "poems")}
	backLabel={strings.section.poems}
	sectionLabel={entry.data.form}
	currentPath={`poems/${slugOf(entry)}`}
	tags={entry.data.tags}
>
	<div class="poem-wrapper" data-poem-strict={strict ? "true" : null}>
		<div class="poem-body"><Content /></div>
		{strict && (
			<figure class="poem-mobile-fallback">
				<img src={poemCardUrl} alt={`${entry.data.title} — static card for small screens`} loading="lazy" />
				<figcaption class="poem-card-caption mono">Static card for small screens</figcaption>
			</figure>
		)}
	</div>
</PieceLayout>