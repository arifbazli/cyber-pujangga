---
import { getCollection, render } from "astro:content";
import { type Locale, localePath, t } from "../../i18n";
import PieceLayout from "../../layouts/PieceLayout.astro";
import { localeOf, slugOf } from "../../lib/content";

export async function getStaticPaths() {
  const entries = await getCollection("journal", ({ data }) => !data.draft);
  return entries
    .filter((e) => localeOf(e) === "ms")
    .map((entry) => ({ params: { slug: slugOf(entry) }, props: { entry } }));
}

const locale: Locale = "ms";
const strings = t(locale);
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<PieceLayout
  title={entry.data.title}
  description={entry.data.description}
  lang={locale}
  pubDate={entry.data.pubDate}
  backHref={localePath(locale, "jurnal")}
  backLabel={strings.section.journal}
  currentPath={`jurnal/${slugOf(entry)}`}
  tags={entry.data.tags}
  ogImage={`/og-image/journal/${entry.id}.png`}
>
  <Content />
</PieceLayout>
