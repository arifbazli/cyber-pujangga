---
import { getCollection, render } from "astro:content";
import AboutLayout from "../../layouts/AboutLayout.astro";
import { t, localePath, type Locale } from "../../i18n";
import { localeOf, slugOf } from "../../lib/content";

const locale: Locale = "en";
const strings = t(locale);

const allPages = await getCollection("pages");
const about = allPages.find((p) => localeOf(p) === "en" && slugOf(p) === "about");
const aboutContent = about ? await render(about) : null;

const title = `Personal writing, <span class="plain">shared quietly</span>, across two languages.`;

const ctas = {
	primary: { href: localePath(locale, "essays"), label: "Read the first essay" },
	secondary: { href: localePath(locale), label: "Return to Home" },
};
---

<AboutLayout locale={locale} currentPath="about" title={title} ctas={ctas}>
	<header class="section-header">
		<p class="section-eyebrow"><a href={localePath(locale)}>← {strings.nav.back}</a></p>
		<h1 class="section-title">{strings.nav.about}</h1>
	</header>

	{aboutContent
		? <aboutContent.Content />
		: <p>{strings.site.description}</p>}

	<nav class="about-links" aria-label="Related links">
		<a href={localePath(locale, "essays")}>{strings.nav.essays}</a>
		<a href={localePath(locale, "journal")}>{strings.nav.journal}</a>
		<a href={localePath(locale, "poems")}>{strings.nav.poems}</a>
		<a href="/en/rss.xml">RSS</a>
	</nav>
</AboutLayout>