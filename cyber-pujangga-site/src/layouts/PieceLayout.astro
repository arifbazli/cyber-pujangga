---
import ShareButton from "@/components/ShareButton.astro";
import type { Locale } from "@/i18n";
// PieceLayout — wrapper for essay, journal, and poem detail pages.
// Header is intentionally minimal: eyebrow back-link and title only.
// Excerpts, byline, dates, read-time and tags have been removed so the
// piece's own voice carries the page.
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/site.config";

interface Props {
  title: string;
  description?: string;
  lang: Locale;
  pubDate: Date;
  updatedDate?: Date;
  backHref: string;
  backLabel: string;
  currentPath?: string;
  tags?: string[];
  ogImage?: string;
}

const {
  title,
  description,
  lang,
  pubDate,
  updatedDate,
  backHref,
  backLabel,
  currentPath = "",
  tags: _tags = [],
  ogImage,
} = Astro.props;

const articleDate = (updatedDate ?? pubDate).toISOString();
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description: description ?? (lang === "ms" ? siteConfig.descriptionMs : siteConfig.description),
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  image: new URL(ogImage ?? "/social-card.png", Astro.site).href,
  inLanguage: lang === "ms" ? "ms-MY" : "en-US",
  author: { "@type": "Person", name: siteConfig.author },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
};
---

<BaseLayout
	title={title}
	description={description}
	lang={lang}
	ogImage={ogImage}
	articleDate={articleDate}
	currentPath={currentPath}
>
	<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
	<main id="main">
		<article class="piece">
			<header class="piece-header">
				<p class="piece-eyebrow">
					<a href={backHref}>← {backLabel}</a>
				</p>

				<h1 class="piece-title kinetic-title">{title}</h1>
			</header>

			<hr class="piece-rule" />

			<div class="post-article">
				<slot />
			</div>

			<footer class="piece-footer">
				<a href={backHref} class="piece-back">← {backLabel}</a>
				<ShareButton lang={lang} url={Astro.url.href} title={title} />
			</footer>
		</article>
	</main>
</BaseLayout>