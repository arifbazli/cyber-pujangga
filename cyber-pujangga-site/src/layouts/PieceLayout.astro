---
import ShareButton from "@/components/ShareButton.astro";
import { type Locale, t } from "@/i18n";
// PieceLayout — wrapper for essay, journal, and poem detail pages.
// Header is intentionally minimal: eyebrow back-link and title only.
// Excerpts, byline, dates, read-time and tags have been removed so the
// piece's own voice carries the page.
import BaseLayout from "@/layouts/BaseLayout.astro";

interface Props {
  title: string;
  description?: string;
  lang: Locale;
  pubDate: Date;
  updatedDate?: Date;
  author: string;
  readingMinutes: number;
  backHref: string;
  backLabel: string;
  sectionLabel: string;
  currentPath?: string;
  tags?: string[];
  ogImage?: string;
}

const {
  title,
  description,
  lang,
  pubDate,
  updatedDate,
  backHref,
  backLabel,
  currentPath = "",
  tags: _tags = [],
  ogImage,
} = Astro.props;

const strings = t(lang);
const articleDate = (updatedDate ?? pubDate).toISOString();
---

<BaseLayout
	title={title}
	description={description}
	lang={lang}
	ogImage={ogImage}
	articleDate={articleDate}
	currentPath={currentPath}
>
	<main id="main">
		<article class="piece">
			<header class="piece-header">
				<p class="piece-eyebrow">
					<a href={backHref}>← {backLabel}</a>
				</p>

				<h1 class="piece-title kinetic-title">{title}</h1>
			</header>

			<hr class="piece-rule" />

			<div class="post-article">
				<slot />
			</div>

			<footer class="piece-footer">
				<a href={backHref} class="piece-back">← {backLabel}</a>
				<ShareButton lang={lang} url={Astro.url.href} title={title} />
			</footer>
		</article>
	</main>
</BaseLayout>