---
/**
 * EntryRow — single compact row in the mockup's entry-list.
 * Click target wraps the whole row, but share button is positioned absolute
 * to allow independent interaction.
 */
import ShareButton from "./ShareButton.astro";
import { type Locale } from "../i18n";

interface Props {
	href: string;
	sectionLabel: string;
	dateLabel: string;
	title: string;
	section: "essays" | "journal" | "poems";
	lang: Locale;
}

const { href, sectionLabel, dateLabel, title, section, lang } = Astro.props;
---

<div class="entry-row" data-reveal data-section={section}>
	<a href={href} class="entry-link">
		<div class="entry-meta">
			<span>{sectionLabel}</span>
			<span>·</span>
			<span>{dateLabel}</span>
		</div>
		<div class="entry-title">{title}</div>
	</a>
	<div class="entry-actions">
		<ShareButton lang={lang} url={href} title={title} />
	</div>
</div>
