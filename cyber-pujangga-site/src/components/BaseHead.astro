---
// BaseHead — all <head> content: meta, OG, canonical, RSS, font preload.
// Adapted from astro-sienna. Stripped of analytics, webmentions, giscus.
import "@/styles/global.css";
import type { Locale } from "@/i18n";
import { siteConfig } from "@/site.config";
// Preload the variable newsreader subset; rest loads via @font-face in global.css.
import newsreaderLatin from "@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url";

interface Props {
  title: string;
  description?: string;
  lang: Locale;
  ogImage?: string;
  articleDate?: string;
}

const { title, description, lang, ogImage, articleDate } = Astro.props;

const titleSeparator = "·";
// Avoid duplicating the site name when the title IS the site name (landing pages).
const siteTitle =
  title === siteConfig.title ? siteConfig.title : `${title} ${titleSeparator} ${siteConfig.title}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = ogImage
  ? new URL(ogImage, Astro.site).href
  : new URL("/social-card.png", Astro.site).href;

const ogLocale = lang === "ms" ? "ms_MY" : "en_US";
const desc = description ?? siteConfig.description;
---

<meta charset="utf-8" />
<meta content="width=device-width, initial-scale=1.0, viewport-fit=cover" name="viewport" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="default" />
<meta name="apple-mobile-web-app-title" content={siteConfig.title} />
<meta name="application-name" content={siteConfig.title} />
<meta name="format-detection" content="telephone=no" />
<meta name="theme-color" content="#1b1a17" />
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#1b1a17" />
<meta name="theme-color" media="(prefers-color-scheme: light)" content="#fbf6ec" />
<meta name="msapplication-TileColor" content="#1b1a17" />
<meta name="color-scheme" content="dark light" />
<title>{siteTitle}</title>

<link href="/favicon.svg" rel="icon" type="image/svg+xml" />

<link href={canonicalURL} rel="canonical" />

<meta content={siteTitle} name="title" />
<meta content={desc} name="description" />
<meta content={siteConfig.author} name="author" />
<meta content={Astro.generator} name="generator" />

<link rel="preload" as="font" type="font/woff2" href={newsreaderLatin} crossorigin />

{/* Default theme-color; ThemeProvider rewrites it to the active theme's bg. */}
<meta content="#fbf6ec" name="theme-color" />

<meta content={articleDate ? "article" : "website"} property="og:type" />
<meta content={title} property="og:title" />
<meta content={desc} property="og:description" />
<meta content={String(canonicalURL)} property="og:url" />
<meta content={siteConfig.title} property="og:site_name" />
<meta content={ogLocale} property="og:locale" />
<meta content={socialImageURL} property="og:image" />
<meta content="1200" property="og:image:width" />
<meta content="630" property="og:image:height" />
{
	articleDate && (
		<>
			<meta content={siteConfig.author} property="article:author" />
			<meta content={articleDate} property="article:published_time" />
		</>
	)
}

<meta content="summary_large_image" property="twitter:card" />
<meta content={String(canonicalURL)} property="twitter:url" />
<meta content={title} property="twitter:title" />
<meta content={desc} property="twitter:description" />
<meta content={socialImageURL} property="twitter:image" />

<link
	href="/rss.xml"
	rel="alternate"
	title={siteConfig.title}
	type="application/rss+xml"
/>
