---
/**
 * Footer — 100% mockup-faithful: social row pill row + copyright line.
 */
import { type Locale, localePath, t } from "../i18n";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const strings = t(lang);
const year = new Date().getFullYear();
---

<footer class="site">
	<div class="social-row">
		<a href={strings.theme.rssPath(lang)}>RSS</a>
		<a href={localePath(lang) === "/" ? "/tentang" : `${localePath(lang)}/about`}>{strings.footer.about}</a>
	</div>
	<p class="copy">© {year} Cyber Pujangga</p>
</footer>